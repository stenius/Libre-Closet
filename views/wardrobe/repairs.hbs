{{>navbar}}
<main class="p-4 pt-20 pb-24 max-w-lg mx-auto">
  <h1 class="text-2xl mb-4">{{t 'lang.REPAIR_LIST'}}</h1>
  <ul class="flex flex-col gap-2">
    {{#each garments}}
    <li class="bg-base-200 rounded-box p-3">
      <a class="link font-medium" href="/wardrobe/{{id}}">{{name}}</a>
      {{#if repairNotes}}<p class="text-sm">{{repairNotes}}</p>{{/if}}
    </li>
    {{else}}
    <li class="text-base-content/60">{{t 'lang.REPAIR_LIST_EMPTY'}}</li>
    {{/each}}
  </ul>
</main>
{{>dock}}
