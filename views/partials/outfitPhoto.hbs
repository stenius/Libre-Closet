<h2 class="font-semibold mb-3">{{t 'lang.OUTFIT_PHOTOS'}}</h2>
{{#each gallery}}
<figure class="mb-3 {{#unless @first}}inline-block align-top w-[calc(50%-0.5rem)] mr-1{{/unless}}">
  <a href="/file/{{fileName}}">
    <img src="/file/{{fileName}}" alt="{{label}}" loading="lazy" class="w-full rounded-box object-contain bg-base-200 {{#if @first}}max-h-[32rem]{{else}}h-56{{/if}}" />
  </a>
  <figcaption class="flex flex-wrap items-center gap-1 mt-1">
    {{#if label}}<span class="text-sm font-medium">{{label}}</span>{{/if}}
    {{#if isCover}}<span class="badge badge-neutral badge-sm">{{t 'lang.OUTFIT_PHOTO_COVER'}}</span>{{/if}}
    {{#unless isCover}}
    <form method="post" action="/outfits/{{../outfit.id}}/photos/{{id}}/cover">
      <button type="submit" class="btn btn-ghost btn-xs">{{t 'lang.OUTFIT_PHOTO_MAKE_COVER'}}</button>
    </form>
    {{/unless}}
    <form method="post" action="{{#if isCover}}/outfits/{{../outfit.id}}/photo/delete{{else}}/outfits/{{../outfit.id}}/photos/{{id}}/delete{{/if}}" onsubmit="return confirm('{{t 'lang.CONFIRM_DELETE'}}')">
      <button type="submit" class="btn btn-ghost btn-xs">{{t 'lang.OUTFIT_PHOTO_REMOVE'}}</button>
    </form>
  </figcaption>
</figure>
{{/each}}
<div class="flex flex-col gap-2 mb-6">
  <input id="outfitPhotoLabel" type="text" maxlength="50" list="outfitPhotoLabels" class="input input-bordered input-sm w-full" placeholder="{{t 'lang.OUTFIT_PHOTO_LABEL'}}" />
  <datalist id="outfitPhotoLabels">
    <option value="{{t 'lang.OUTFIT_PHOTO_JACKET_ON'}}"></option>
    <option value="{{t 'lang.OUTFIT_PHOTO_JACKET_OFF'}}"></option>
  </datalist>
  <div class="flex flex-wrap gap-2">
    <form method="post" enctype="multipart/form-data" data-photo-action="/outfits/{{outfit.id}}/photos">
      <label class="btn btn-neutral btn-sm">
        {{t 'lang.OUTFIT_PHOTO_TAKE'}}
        <input id="outfitPhotoCapture" type="file" name="photo" accept="image/jpeg,image/png,image/gif,image/webp" capture="environment" class="hidden" onchange="submitOutfitPhoto(this)" />
      </label>
    </form>
    <form method="post" enctype="multipart/form-data" data-photo-action="/outfits/{{outfit.id}}/photos">
      <label class="btn btn-outline btn-sm">
        {{t 'lang.OUTFIT_PHOTO_CHOOSE'}}
        <input id="outfitPhotoFile" type="file" name="photo" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" onchange="submitOutfitPhoto(this)" />
      </label>
    </form>
  </div>
</div>
<script>
  function submitOutfitPhoto(input) {
    const label = document.getElementById('outfitPhotoLabel').value.trim();
    const form = input.form;
    form.action =
      form.dataset.photoAction +
      (label ? '?label=' + encodeURIComponent(label) : '');
    form.submit();
  }
</script>
