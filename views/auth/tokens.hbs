{{>navbar}}
<main class="flex flex-col items-center gap-4 p-4 max-w-xl mx-auto w-full">
  <h1 class="text-2xl">{{t 'lang.API_TOKENS'}}</h1>

  {{#if newToken}}
  <div class="alert alert-success flex-col items-start w-full">
    <span>{{t 'lang.API_TOKEN_COPY_NOW'}}</span>
    <code class="break-all select-all">{{newToken}}</code>
  </div>
  {{/if}}

  <form method="post" action="/auth/tokens" class="flex gap-2 w-full">
    <input type="text" name="name" required maxlength="100" class="input input-bordered flex-1" placeholder="{{t 'lang.API_TOKEN_NAME'}}" />
    <button type="submit" class="btn btn-primary">{{t 'lang.API_TOKEN_CREATE'}}</button>
  </form>

  <ul class="w-full flex flex-col gap-2">
    {{#each tokens}}
    <li class="flex justify-between items-center gap-2 bg-base-200 rounded-box p-3">
      <div>
        <p class="font-medium">{{name}}</p>
        <p class="text-sm text-base-content/60">{{t 'lang.API_TOKEN_LAST_USED'}}: {{#if lastUsedAt}}{{formatDate lastUsedAt}}{{else}}{{t 'lang.API_TOKEN_NEVER_USED'}}{{/if}}</p>
      </div>
      <form method="post" action="/auth/tokens/{{id}}/delete">
        <button type="submit" class="btn btn-ghost btn-sm">{{t 'lang.API_TOKEN_REVOKE'}}</button>
      </form>
    </li>
    {{/each}}
  </ul>
</main>
{{>dock}}
