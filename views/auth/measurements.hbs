{{>navbar}}
<main class="flex flex-col items-center gap-4 p-4 max-w-sm mx-auto w-full">
  <h1 class="text-2xl">{{t 'lang.MEASUREMENTS'}}</h1>
  <form method="post" action="/auth/measurements" class="flex flex-col gap-2 w-full">
    <label class="form-control"><span class="label-text">{{t 'lang.MEASUREMENT_CHEST'}}</span><input type="number" step="0.25" min="0" max="100" name="chest" class="input input-bordered" value="{{measurements.chest}}" /></label>
    <label class="form-control"><span class="label-text">{{t 'lang.MEASUREMENT_SHOULDERS'}}</span><input type="number" step="0.25" min="0" max="100" name="shoulders" class="input input-bordered" value="{{measurements.shoulders}}" /></label>
    <label class="form-control"><span class="label-text">{{t 'lang.MEASUREMENT_WAIST'}}</span><input type="number" step="0.25" min="0" max="100" name="waist" class="input input-bordered" value="{{measurements.waist}}" /></label>
    <label class="form-control"><span class="label-text">{{t 'lang.MEASUREMENT_INSEAM'}}</span><input type="number" step="0.25" min="0" max="100" name="inseam" class="input input-bordered" value="{{measurements.inseam}}" /></label>
    <label class="form-control"><span class="label-text">{{t 'lang.MEASUREMENT_NECK'}}</span><input type="number" step="0.25" min="0" max="100" name="neck" class="input input-bordered" value="{{measurements.neck}}" /></label>
    <button type="submit" class="btn btn-primary mt-2">{{t 'lang.SAVE'}}</button>
  </form>
</main>
{{>dock}}
